# PostgreSQL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/genview

# OpenRouter API Key
OPENROUTER_API_KEY=your-openrouter-api-key-here

# MemOS Cloud 记忆服务 (https://github.com/MemTensor/MemOS)
MEMOS_API_KEY=your-memos-api-key-here
MEMOS_BASE_URL=https://memos.memtensor.cn/api/openmem/v1
MEMOS_ENABLED=false

# CORS origins (comma-separated in env, but pydantic-settings parses JSON list)
CORS_ORIGINS=["http://localhost:3000"]

# Frontend URL for screenshot capture (Playwright navigates here)
FRONTEND_URL=http://localhost:3000

# LightRAG 知识图谱
LIGHTRAG_WORKING_DIR=./data/lightrag
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Embedding（OpenAI 兼容 API，可与 OpenRouter 或独立服务）
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1

# LightRAG 本地模式（Ollama，不消耗 API token；切换模式需重新构建图谱）
LIGHTRAG_USE_LOCAL=false
LIGHTRAG_OLLAMA_HOST=http://localhost:11434
LIGHTRAG_OLLAMA_LLM=qwen2.5:7b
LIGHTRAG_OLLAMA_EMBED=nomic-embed-text
LIGHTRAG_OLLAMA_EMBED_DIM=768
# Qwen3.5 等 thinking 模型：false 关闭 thinking 加速，true 启用推理链
LIGHTRAG_OLLAMA_THINK=false
