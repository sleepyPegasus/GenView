# PostgreSQL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/genview

# OpenRouter API Key
OPENROUTER_API_KEY=your-openrouter-api-key-here

# MemOS Cloud 记忆服务 (https://github.com/MemTensor/MemOS)
MEMOS_API_KEY=your-memos-api-key-here
MEMOS_BASE_URL=https://memos.memtensor.cn/api/openmem/v1
MEMOS_ENABLED=false

# CORS origins (comma-separated in env, but pydantic-settings parses JSON list)
CORS_ORIGINS=["http://localhost:3000"]

# Frontend URL for screenshot capture (Playwright navigates here)
FRONTEND_URL=http://localhost:3000
